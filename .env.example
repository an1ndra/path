# Public API
PORT=8080

# Admin API. Leave empty to disable it entirely.
GATEWAY_ADMIN_TOKEN=change-me-to-something-long

# Providers — set the ones you have.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Any other provider slug, e.g. for slug "together":
# GATEWAY_UPSTREAM_TOGETHER_KEY=

# Optional tuning
GATEWAY_PUBLIC_MODELS=true
GATEWAY_CORS_ORIGINS=*
GATEWAY_BOOTSTRAP_DEMO_KEY=true
GATEWAY_DEFAULT_RPM=120
# GATEWAY_DEFAULT_CREDIT_USD=25

# A stable 32-byte base64 key for encrypting stored credentials.
# Generate with: openssl rand -base64 32
GATEWAY_MASTER_KEY=

# Postgres (otherwise a local H2 file under ./data)
# SPRING_PROFILES_ACTIVE=postgres
# DB_URL=jdbc:postgresql://localhost:5432/aigateway
# DB_USER=aigateway
# DB_PASSWORD=aigateway
