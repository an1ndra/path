meta {
  name: Create API key
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/keys
  body: json
  auth: none
}

headers {
  X-Admin-Token: {{adminToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "bruno-demo",
    "credit_limit_usd": 5,
    "rpm_limit": 120
  }
}

docs {
  Mints a client key and stores it in `apiKey`. The plaintext is returned once; every later chat request depends on it.
}

script:post-response {
  bru.setVar("apiKey", res.body.key);
  bru.setVar("keyId", res.body.id);
}
