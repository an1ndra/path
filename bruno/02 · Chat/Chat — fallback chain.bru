meta {
  name: Chat — fallback chain
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "model": "{{model}}",
    "models": [
      "gpt-4o-mini",
      "claude-3.5-haiku"
    ],
    "provider": {
      "order": [
        "openai",
        "anthropic"
      ],
      "allow_fallbacks": true
    },
    "messages": [
      {
        "role": "user",
        "content": "hello"
      }
    ]
  }
}
