<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.github.an1ndra</groupId>
    <artifactId>path-parent</artifactId>
    <version>0.2.2</version>
    <packaging>pom</packaging>
    <name>path-parent</name>
    <description>Build parent for Path, the provider-agnostic LLM gateway, and its Spring AI adapter</description>
    <url>https://github.com/an1ndra/path</url>

    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>an1ndra</id>
            <name>Anindra</name>
            <url>https://github.com/an1ndra</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/an1ndra/path</url>
        <connection>scm:git:https://github.com/an1ndra/path.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/an1ndra/path.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.8</spring-ai.version>

        <!--
          Spring Boot 3.5.16 manages tomcat 10.1.55 and netty 4.1.135, both of which carry
          CRITICAL advisories already fixed upstream. Pinning them keeps the container scan
          clean without waiting for a Boot patch release; drop the overrides once Boot
          manages the fixed versions itself.
        -->
        <tomcat.version>10.1.62</tomcat.version>
        <netty.version>4.1.141.Final</netty.version>
    </properties>

    <modules>
        <!-- The gateway stays the published io.github.an1ndra:path artifact; the Spring AI
             adapter is a sibling that depends on Spring AI, never the other way round. -->
        <module>path-gateway</module>
        <module>path-spring-ai</module>
    </modules>

    <profiles>
        <!--
          Publishing to Maven Central.

          Prerequisites (see docs/PUBLISHING.md):
            * verified namespace io.github.an1ndra (GitHub); the Java package stays
              com.anindra.path, only these coordinates change
            * a GPG key whose public half is on keys.openpgp.org
            * ~/.m2/settings.xml with a "central" server holding a Portal token

          mvn -P release deploy
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Only in this profile: keeps target/ to one jar for Docker and CI. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Publish the plain library jar. The runnable jar is built by the
                         normal release workflow, not uploaded to Central. -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Upload only; release it from the Portal after reviewing. -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
